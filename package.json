  "bugs": "https://github.com/Bluente/bluente-translate-mcp-server/issues",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "dotenv": "^16.6.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
