{
  "name": "@bluente/translate-mcp-server",
  "version": "0.2.0",
  "description": "Open-source MCP server for Bluente translation APIs",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "bluente-translate-mcp": "src/index.js"
  },
